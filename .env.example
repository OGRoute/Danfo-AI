# ---------------------------------------------------------------------------
# DanfoAI environment configuration.
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must NEVER be committed (it holds your private key).
# Never put real keys in THIS file — it is committed to git.
# ---------------------------------------------------------------------------

# 0G testnet wallet private key (hex, with or without 0x prefix).
# Required by chat, transcription, storage and chain features.
# Use a DEDICATED testnet wallet — never a wallet holding real funds.
PRIVATE_KEY=

# 0G EVM RPC endpoint (defaults to the public testnet RPC if unset).
# The public testnet RPC is slow; point this at a faster/private RPC if you have one.
RPC_URL=https://evmrpc-testnet.0g.ai

# --- Authentication (Clerk — Google, email and more) ---
# Local development works WITHOUT keys: Clerk runs in keyless mode and shows a
# "Claim application" badge so you can adopt the temporary instance.
# For production, create an app at https://dashboard.clerk.com → API Keys, and
# enable the sign-in methods you want under User & Authentication.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx
# Set to 1 to turn keyless mode off (wallet + anonymous sign-in only).
# NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
# A Clerk PRODUCTION instance (pk_live) normally needs DNS records on your own
# domain. On *.vercel.app that's impossible, so point the instance's proxy_url
# at this app (Clerk dashboard → Domains) and set the same URL here; the app
# serves it from app/api/clerk-proxy via a /__clerk rewrite.
# NEXT_PUBLIC_CLERK_PROXY_URL=https://your-app.vercel.app/__clerk
# CLERK_FRONTEND_API_HOST=frontend-api.clerk.dev

# Optional: raise if you see "TIMEOUT" errors on the slow public RPC (ms).
# RPC_TIMEOUT_MS=120000

# --- Intron Voice AI (speech-to-text + text-to-speech for Nigerian languages) ---
# Get a key at https://voice.intron.io (Developers tab). Server-side only —
# never expose it in client code. With it set:
#  - voice input uses Intron for English, Pidgin, Yoruba, Igbo and Hausa, and
#    "Auto-detect" identifies which of them the rider is speaking;
#  - the 🔊 button speaks replies with Intron's native voices.
# Without it, voice input falls back to local Whisper / the browser (English
# only) and replies are read by the browser voice or YarnGPT.
# INTRON_API_KEY=
# Languages tried in parallel on "Auto-detect" (first phrase of each recording).
# INTRON_AUTO_LANGUAGES=pcm,yo,ig,ha
# Text-to-speech voice: female | male, and the accent used for English replies
# (yoruba | igbo | hausa).
# INTRON_TTS_GENDER=female
# INTRON_TTS_EN_ACCENT=yoruba
# Optional endpoint overrides — HTTPS request endpoints only. Don't put Intron's
# wss:// streaming URLs (.../stt/v1/stream, .../tts/v1/stream) here: they use a
# different protocol, so the app ignores them and uses these defaults.
# INTRON_API_BASE=https://infer.voice.intron.io
# INTRON_STT_URL=https://infer.voice.intron.io/file/v1/upload/sync
# INTRON_TTS_URL=https://infer.voice.intron.io/tts/v1/generate

# Optional: Intron's embeddable streaming widget (@intron_health/intron_transcriber_streaming)
# instead of the built-in mic. The widget has no language setting, so it can't
# be told to expect Pidgin, Yoruba, Igbo or Hausa — the INTRON_API_KEY path above
# is recommended. Needs a PUBLIC widget key.
# NEXT_PUBLIC_INTRON_WIDGET=1
# NEXT_PUBLIC_INTRON_API_KEY=

# --- Voice-to-text fallback (local Whisper; auto-detects language) ---
# The YarnGPT service also runs Whisper STT at /stt. Defaults to YARNGPT_API_URL
# if unset; only set STT_API_URL to point STT at a different host than TTS.
# STT_API_URL=http://localhost:8000
# STT_TIMEOUT_MS=300000

# --- Optional: pin specific 0G providers instead of auto-discovery ---
# PROVIDER_ADDRESS=            # chat / LLM inference provider
# STT_PROVIDER_ADDRESS=        # speech-to-text (Whisper) provider

# --- Optional: 0G Compute ledger funding ---
# The app funds each provider sub-account itself (the contract minimum is
# 0.1 0G) and disables the 0G SDK's automatic top-up, which would otherwise lock
# 1 0G per new provider and try to keep ~8.8 0G locked for the chat model.
# It tops the sub-account up to the target whenever it drops below the minimum.
# COMPUTE_MIN_BALANCE_OG=0.2
# COMPUTE_TARGET_BALANCE_OG=0.5
# Longest reply, in tokens (≈0.003 0G per full reply at current testnet prices).
# COMPUTE_MAX_TOKENS=900
# Languages the chat model may phrase trip answers in. The only testnet chat
# model (qwen2.5-omni-7b) garbles Yoruba, Igbo and Hausa and drifts into English
# for Pidgin, so trips asked in those are answered from built-in templates in
# that language. Add pcm,yo,ig,ha when 0G offers a stronger model.
# MODEL_REPLY_LANGUAGES=en

# --- Optional: live map routing ---
# OSRM server for road-following routes on the map (public demo server by default).
# OSRM_URL=https://router.project-osrm.org

# --- Optional: 0G Storage / Chain ---
# STORAGE_INDEXER=
# ROUTES_ROOT_HASH=
# RouteCorrections contract on 0G Chain — rider feedback is recorded here and
# folded back into the route data (npm run deploy:contract prints a new one).
# CORRECTIONS_CONTRACT=
# How many riders must report the same fare before it overrides the published one.
# CORRECTION_MIN_REPORTS=2
# Feedback rate limits (on-chain writes cost gas from the app wallet).
# FEEDBACK_MAX_PER_HOUR=6
# FEEDBACK_MAX_PER_DAY=200

# --- YarnGPT (Nigerian text-to-speech fallback) ---
# Base URL of a running YarnGPT TTS service (see yarngpt-service/README.md).
YARNGPT_API_URL=http://localhost:8000
